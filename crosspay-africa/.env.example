# Configuration générale
NODE_ENV=development
PORT=3000
PAYMENTS_SERVICE_PORT=3001
ADMIN_PORT=3002

# Base de données
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crosspay
DB_SYNCHRONIZE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=1d

# Agrégateurs de paiement
# MFS Africa
MFS_API_KEY=your_mfs_api_key
MFS_API_SECRET=your_mfs_api_secret
MFS_API_URL=https://api.mfs.africa/v1

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_API_URL=https://api.flutterwave.com/v3

# Beyonic
BEYONIC_API_KEY=your_beyonic_api_key
BEYONIC_API_URL=https://api.beyonic.com/api

# Webhook Security
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# ======================================
# 🆕 NOUVELLES FONCTIONNALITÉS
# ======================================

# Reloadly (Achat d'Airtime)
RELOADLY_CLIENT_ID=your_reloadly_client_id
RELOADLY_CLIENT_SECRET=your_reloadly_client_secret
RELOADLY_API_URL=https://topups-sandbox.reloadly.com
RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token
# Note: Utiliser https://topups.reloadly.com en production

# IA & Prédictions
AI_MIN_CONFIDENCE=60           # Confiance minimum pour afficher suggestion (0-100)
AI_MAX_SUGGESTIONS=5           # Nombre max de suggestions par utilisateur
AI_HISTORY_MONTHS=6            # Mois d'historique à analyser
AI_MIN_TRANSACTIONS=2          # Transactions min pour créer prédiction

# Gamification
REFERRAL_REWARD_POINTS=5000    # Points pour parrainage réussi
DAILY_LOGIN_POINTS=10          # Points pour connexion quotidienne
POINTS_TO_XOF_RATE=1           # 1 point = 1 XOF

# OpenAI (pour IA avancée - Phase 3)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# Stripe Issuing (pour Cartes Virtuelles - Phase 3)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email & Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@crosspay.africa

# SMS (Twilio ou autre)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Analytics
MIXPANEL_TOKEN=your_mixpanel_token
AMPLITUDE_API_KEY=your_amplitude_api_key

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn

# Frontend URLs
ADMIN_URL=http://localhost:4000
MOBILE_DEEP_LINK=crosspay://

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4000