# Configuration générale
NODE_ENV=development
PORT=3000
PAYMENTS_SERVICE_PORT=3001
ADMIN_PORT=3002

# Base de données
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crosspay
DB_SYNCHRONIZE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=1d

# Agrégateurs de paiement
# MFS Africa
MFS_API_KEY=your_mfs_api_key
MFS_API_SECRET=your_mfs_api_secret
MFS_API_URL=https://api.mfs.africa/v1

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key
FLUTTERWAVE_API_URL=https://api.flutterwave.com/v3

# Beyonic
BEYONIC_API_KEY=your_beyonic_api_key
BEYONIC_API_URL=https://api.beyonic.com/api

# Webhook Security
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug